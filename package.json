{
  "name": "ha-github-bot",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "start": "node dist/main.js",
    "dev": "nest start -b swc --watch",
    "build": "nest build -b swc",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "capture": "node scripts/capture-webhooks.ts",
    "scrub": "node scripts/capture-webhooks.ts scrub",
    "capture-discord": "pnpm build && node scripts/capture-discord.ts",
    "migrate-cla": "pnpm build && node scripts/migrate-cla-from-dynamodb.ts",
    "verify-cla": "pnpm build && node scripts/verify-cla-migration.ts",
    "sync-templates": "node scripts/sync-templates.ts",
    "check-io-sections": "pnpm build && node scripts/check-io-sections.ts"
  },
  "lint-staged": {
    "*": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/openapi-webhooks-types": "^12.2.0",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks-methods": "^6.0.0",
    "@sentry/nestjs": "^11.11.0",
    "discord.js": "^14.28.1",
    "kysely": "^0.29.8",
    "mustache": "^4.2.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "@biomejs/biome": "^2.6.6",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.4.0",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "chokidar": "^6.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "supertest": "^7.3.2",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
